#!/bin/sh
set -euo pipefail

# Ensure bun is available
if ! command -v bun >/dev/null 2>&1; then
    echo "ERROR: bun not found in PATH"
    exit 1
fi

# ---- Original sample checks ----
if git rev-parse --verify HEAD >/dev/null 2>&1; then
    against=HEAD
else
    against=$(git hash-object -t tree /dev/null)
fi

# Get config, default to false if missing
allownonascii=$(git config --type=bool hooks.allownonascii 2>/dev/null) || allownonascii=false

if [ "$allownonascii" != "true" ]; then
    # Check for non-ASCII filenames
    if git diff-index --cached --name-only --diff-filter=A -z $against |
         tr '\0' '\n' |
         LC_ALL=C grep -q '[^ -~]'; then
        cat <<\EOF
Error: Attempt to add a non-ASCII file name.
EOF
        exit 1
    fi
fi

git diff-index --check --cached $against -- || exit 1

# ---- Checks ----
# The same three scripts as `bun run ltf:check`, followed by the plain
# (no --retry) test run so a real failure still blocks the commit
# instead of being retried away.
bun run fmt:check
bun check
bun run lint
bun test

echo "All checks passed!"
echo "Writing commit object..."
